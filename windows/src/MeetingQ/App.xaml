<Application x:Class="MeetingQ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Global color palette -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFB347"/>
            <SolidColorBrush x:Key="DangerBrush"  Color="#FF6B6B"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F5F5"/>

            <!-- Default button style override (flat, rounded) -->
            <Style TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
