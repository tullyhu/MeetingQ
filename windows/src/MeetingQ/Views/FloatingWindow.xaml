<Window x:Class="MeetingQ.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MeetingQ.ViewModels"
        mc:Ignorable="d"
        Title="MeetingQ"
        Width="320" Height="440"
        MinWidth="260" MinHeight="340"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        d:DataContext="{d:DesignInstance Type=vm:FloatingWindowViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Icon button (title bar) ── -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14000000"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost / outline button (self-test) ── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14818CF8"/>
                                <Setter Property="BorderBrush" Value="#818CF8"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                                <Setter Property="BorderBrush" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Pill button (start / stop) — colors set via DataTrigger on parent ── -->
        <ControlTemplate x:Key="PillBtnTemplate" TargetType="Button">
            <Border x:Name="PillBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="PillBorder" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="PillBorder" Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PillBorder" Property="Background" Value="#C7C7C7"/>
                    <Setter Property="Foreground" Value="#F5F5F5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── Topic highlight flash ── -->
        <Storyboard x:Key="TopicFlash">
            <ColorAnimation Storyboard.TargetName="TopicHighlight"
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            From="#FFE0E7FF" To="#00E0E7FF"
                            Duration="0:0:1.2">
                <ColorAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>

        <!-- ── Diagnostic row data template ── -->
        <DataTemplate x:Key="DiagStepTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Icon}"
                           Foreground="{Binding IconColor}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           Foreground="#666666"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Detail}"
                           Foreground="{Binding DetailColor}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  Outer shell                                           -->
    <!-- ══════════════════════════════════════════════════════ -->
    <Border CornerRadius="12"
            Margin="10"
            Background="#FFFFFF"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Title bar -->
                <RowDefinition Height="26"/>   <!-- Status strip -->
                <RowDefinition Height="Auto"/> <!-- Window picker (pre-start) -->
                <RowDefinition Height="Auto"/> <!-- Diagnostic panel -->
                <RowDefinition Height="Auto"/> <!-- Topic -->
                <RowDefinition Height="*"/>    <!-- Transcript -->
                <RowDefinition Height="Auto"/> <!-- Inline summary -->
                <RowDefinition Height="Auto"/>   <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- ══ Row 0 · Title bar ══ -->
            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Background="Transparent"
                    MouseDown="TitleBar_MouseDown">
                <!-- Subtle bottom separator -->
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                        <GradientStop Color="#00E0E0E0" Offset="0"/>
                        <GradientStop Color="#FFE0E0E0" Offset="0.3"/>
                        <GradientStop Color="#FFE0E0E0" Offset="0.7"/>
                        <GradientStop Color="#00E0E0E0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <Grid Margin="14,0,8,0">
                    <!-- App name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Accent dot colored by monitoring state -->
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#CCCCCC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelfTestRunning}" Value="True">
                                            <Setter Property="Fill" Value="#818CF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="MeetingQ"
                                   Foreground="#111111"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0">
                        <Button Content="●"
                                Command="{Binding ToggleDiagnosticsCommand}"
                                ToolTip="自检状态">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasSelfTestResult}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="⧉"
                                Style="{StaticResource IconBtn}"
                                Click="OpenHistory_Click"
                                ToolTip="历史会议"/>
                        <Button Content="⚙"
                                Style="{StaticResource IconBtn}"
                                Click="OpenSettings_Click"
                                ToolTip="设置"/>
                        <Button Content="▾"
                                Style="{StaticResource IconBtn}"
                                Click="CloseButton_Click"
                                ToolTip="隐藏到托盘"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Row 1 · Status strip ══ -->
            <Border Grid.Row="1" Padding="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live indicator -->
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#CCCCCC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#555555"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  "
                               Foreground="#DDDDDD"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElapsedTime}"
                               Foreground="#888888"
                               FontSize="11"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══ Row 2 · Window picker (hidden while monitoring) ══ -->
            <Border Grid.Row="2"
                    Margin="10,4,10,4"
                    Background="#F5F5F5"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="8,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="截图窗口"
                               Foreground="#777777"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="WindowPickerCombo"
                              Grid.Column="1"
                              IsEditable="True"
                              Text="{Binding CaptureWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding AvailableWindows}"
                              SelectionChanged="WindowPickerCombo_SelectionChanged"
                              Background="#F5F5F5"
                              Foreground="#111111"
                              BorderBrush="#DDDDDD"
                              BorderThickness="1"
                              FontSize="11"
                              Padding="6,3"
                              VerticalContentAlignment="Center">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#111111"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                    <TextBlock Grid.Column="1"
                               Text="未检测到可捕获窗口"
                               Foreground="#AAAAAA"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding AvailableWindows.Count}" Value="0"/>
                                            <Condition Binding="{Binding CaptureWindowTitle}" Value=""/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2"
                            Content="↺"
                            Style="{StaticResource IconBtn}"
                            Command="{Binding RefreshWindowsCommand}"
                            ToolTip="刷新窗口列表"
                            FontSize="14"
                            Width="26" Height="26"
                            Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- ══ Row 3 · Diagnostic panel (collapsible) ══ -->
            <Border Grid.Row="3"
                    Margin="10,0,10,6"
                    Background="#F5F5F5"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="10,8"
                    Visibility="{Binding IsDiagnosticVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- 4px left accent -->
                    <Rectangle HorizontalAlignment="Left"
                               Width="3"
                               RadiusX="2" RadiusY="2"
                               Margin="-10,2,-10,2"
                               VerticalAlignment="Stretch">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel Margin="6,0,0,0">
                        <ScrollViewer MaxHeight="160"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DiagnosticSteps}"
                                          ItemTemplate="{StaticResource DiagStepTemplate}"/>
                        </ScrollViewer>

                        <!-- Self-test result badge -->
                        <Border Margin="0,6,0,0"
                                CornerRadius="6"
                                Padding="8,5"
                                Visibility="{Binding HasSelfTestResult, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFEEEE"/>
                                    <Setter Property="BorderBrush" Value="#FFCCCC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelfTestPassed}" Value="True">
                                            <Setter Property="Background" Value="#EEFFEE"/>
                                            <Setter Property="BorderBrush" Value="#CCFFCC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelfTestResult}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CC3333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelfTestPassed}" Value="True">
                                                <Setter Property="Foreground" Value="#228B22"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Hint -->
                        <Border Margin="0,4,0,0"
                                CornerRadius="6"
                                Padding="8,5"
                                Background="#FFFBEE"
                                BorderBrush="#FFE580"
                                BorderThickness="1"
                                Visibility="{Binding HasDiagnosticHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DiagnosticHint}"
                                           Foreground="#997700"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Row 4 · Current topic ══ -->
            <Border x:Name="TopicHighlight"
                    Grid.Row="4"
                    Margin="10,0,10,8"
                    CornerRadius="6"
                    Padding="4,3,4,3">
                <Border.Background>
                    <SolidColorBrush Color="#00E0E7FF"/>
                </Border.Background>
                <Grid>
                    <!-- Left accent line -->
                    <Rectangle HorizontalAlignment="Left"
                               Width="3"
                               RadiusX="2" RadiusY="2"
                               Fill="#6366F1"/>
                    <StackPanel Margin="11,0,0,0">
                        <TextBlock Text="当前议题"
                                   Foreground="#777777"
                                   FontSize="10"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentTopic}"
                                   Foreground="#111111"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Row 5 · Transcript ══ -->
            <Border Grid.Row="5"
                    Margin="10,0,10,6"
                    Background="#F8F8F8"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">
                <Grid>
                    <TextBlock Text="等待语音输入…"
                               Foreground="#BBBBBB"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LatestTranscript}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer x:Name="TranscriptScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,8"
                                  ScrollChanged="TranscriptScroller_ScrollChanged">
                        <TextBlock Text="{Binding LatestTranscript}"
                                   Foreground="#222222"
                                   FontSize="12"
                                   LineHeight="22"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ Row 6 · Inline summary ══ -->
            <Border Grid.Row="6"
                    Margin="10,0,10,6"
                    Background="#F0F0F0"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    MaxHeight="110">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInlineSummary}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInlineSummaryLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,7,10,7">
                    <!-- Label row -->
                    <TextBlock Text="AI 摘要"
                               Foreground="#777777"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"/>
                    <!-- Loading indicator -->
                    <TextBlock Text="生成中…"
                               Foreground="#AAAAAA"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Visibility="{Binding IsInlineSummaryLoading, Converter={StaticResource BoolToVis}}"/>
                    <!-- Summary text -->
                    <ScrollViewer Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding InlineSummaryText}"
                                   Foreground="#444444"
                                   FontSize="11"
                                   LineHeight="18"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ Row 7 · Bottom bar ══ -->
            <Border Grid.Row="7"
                    CornerRadius="0,0,12,12"
                    Padding="12,0">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00E0E0E0" Offset="0"/>
                        <GradientStop Color="#FFE0E0E0" Offset="0.3"/>
                        <GradientStop Color="#FFE0E0E0" Offset="0.7"/>
                        <GradientStop Color="#00E0E0E0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,1,0,0</Border.BorderThickness>

                <Grid>
                    <!-- Right side controls (wrap when narrow) -->
                    <WrapPanel HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <!-- Screenshot album button (visible during and after session) -->
                        <Button Padding="8,4"
                                Margin="0,2,4,2"
                                Content="📷 截图"
                                Command="{Binding OpenScreenshotAlbumCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSessionData}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Multimodal mode toggle (always visible) -->
                        <Button Padding="8,4"
                                Margin="0,2,4,2"
                                Content="{Binding MultimodalButtonText}"
                                Command="{Binding ToggleMultimodalModeCommand}"
                                Style="{StaticResource GhostBtn}"
                                Foreground="#7C3AED"/>

                        <!-- Quick summary button (visible during and after session) -->
                        <Button Padding="8,4"
                                Margin="0,2,4,2"
                                Content="⚡ 摘要"
                                Command="{Binding ShowQuickSummaryCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSessionData}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                        <!-- Manual alert trigger (visible only during monitoring) -->
                        <Button Padding="8,4"
                                Margin="0,2,4,2"
                                Command="{Binding ManualTriggerAlertCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground"  Value="#D97706"/>
                                    <Setter Property="Content"     Value="🔔 被叫到"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualAlertRunning}" Value="True">
                                            <Setter Property="Content" Value="收集中…"/>
                                            <Setter Property="Foreground" Value="#818CF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Self-test ghost button -->
                        <Button Padding="8,4"
                                Margin="0,2,4,2"
                                Command="{Binding RunSelfTestCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                    <Setter Property="Content" Value="功能自检"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelfTestRunning}" Value="True">
                                            <Setter Property="Content" Value="自检中…"/>
                                            <Setter Property="Foreground" Value="#818CF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Start / Stop pill button -->
                        <Button Padding="14,6"
                                Margin="0,2,0,2"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Template="{StaticResource PillBtnTemplate}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content"    Value="开始监听"/>
                                    <Setter Property="Background" Value="#6366F1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Command"    Value="{Binding StartListeningCommand}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStarting}" Value="True">
                                            <Setter Property="Content"    Value="启动中…"/>
                                            <Setter Property="IsEnabled"  Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Content"    Value="停止监听"/>
                                            <Setter Property="Background" Value="#EF4444"/>
                                            <Setter Property="Command"    Value="{Binding StopListeningCommand}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
