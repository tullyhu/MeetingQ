<Window x:Class="MeetingQ.Views.ScreenshotAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:MeetingQ.ViewModels"
        mc:Ignorable="d"
        Title="截图时光轴"
        Width="720" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Topmost="False"
        ShowInTaskbar="True"
        d:DataContext="{d:DesignInstance Type=vm:ScreenshotAlbumViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Inverted bool → visibility -->
        <Style x:Key="InverseBoolVis" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasScreenshots}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thumbnail ListBox item style -->
        <Style x:Key="ThumbItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="Margin"            Value="4,6"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ThumbBorder"
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Background="#0A000000">
                            <StackPanel>
                                <Border CornerRadius="5,5,0,0"
                                        Width="90" Height="52"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding TimeLabel}"
                                           Foreground="#888888"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,4"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#FFB347"/>
                                <Setter TargetName="ThumbBorder" Property="Background"  Value="#1AFFB347"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background"  Value="#14000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button (matches FloatingWindow style) -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#555555"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#14818CF8"/>
                                <Setter Property="BorderBrush" Value="#818CF8"/>
                                <Setter Property="Foreground"  Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#FFFFFF"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Preview area -->
                <RowDefinition Height="Auto"/> <!-- Info bar + analysis -->
                <RowDefinition Height="1"/>    <!-- Separator -->
                <RowDefinition Height="104"/>  <!-- Thumbnail strip -->
            </Grid.RowDefinitions>

            <!-- ══ Row 0 · Title bar ══ -->
            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Background="Transparent"
                    MouseDown="TitleBar_MouseDown">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                        <GradientStop Color="#00E0E0E0" Offset="0"/>
                        <GradientStop Color="#FFE0E0E0" Offset="0.3"/>
                        <GradientStop Color="#FFE0E0E0" Offset="0.7"/>
                        <GradientStop Color="#00E0E0E0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📷" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="截图时光轴"
                                   Foreground="#111111"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CountLabel}"
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#888888"
                            FontSize="13"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ══ Row 1 · Preview area ══ -->
            <Border Grid.Row="1"
                    Margin="10,10,10,0"
                    Background="#F5F5F5"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel Style="{StaticResource InverseBoolVis}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="📷"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="暂无截图"
                                   Foreground="#AAAAAA"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="开始监听后将每 30 秒自动截图"
                                   Foreground="#BBBBBB"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Screenshot preview -->
                    <Image Source="{Binding SelectedImage}"
                           Stretch="Uniform"
                           Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- ══ Row 2 · Info bar ══ -->
            <Border Grid.Row="2"
                    Margin="10,4,10,4"
                    Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SelectedTimestamp}"
                           Foreground="#888888"
                           FontSize="11"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Margin="0,4"/>
            </Border>

            <!-- ══ Row 3 · Separator ══ -->
            <Rectangle Grid.Row="3" Fill="#EEEEEE"/>

            <!-- ══ Row 4 · Thumbnail strip ══ -->
            <Border Grid.Row="4"
                    Background="#F5F5F5"
                    CornerRadius="0,0,12,12">
                <ListBox x:Name="ThumbnailList"
                         ItemsSource="{Binding Screenshots}"
                         SelectedItem="{Binding SelectedScreenshot}"
                         ItemContainerStyle="{StaticResource ThumbItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</Window>
