<Window x:Class="MeetingQ.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:MeetingQ.ViewModels"
        xmlns:local="clr-namespace:MeetingQ.Infrastructure"
        mc:Ignorable="d"
        Title="{local:Loc SettingsWindowTitle}"
        Width="660" Height="620"
        MinWidth="520" MinHeight="480"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        Foreground="#111111"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Cursor="Hand"
                                BorderThickness="0,0,0,2">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="TabUnderline" Color="Transparent"/>
                            </Border.BorderBrush>
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#818CF8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="InfoBox" TargetType="Border">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TestBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile list item -->
        <Style x:Key="ProfileListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F8F8F8" Padding="24,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.2"/>
                    <GradientStop Color="#FF6366F1" Offset="0.5"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.8"/>
                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="MeetingQ" Foreground="#818CF8" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="  /" Foreground="#DDDDDD" FontSize="14"/>
                <TextBlock Text="{local:Loc SettingsHeader}" Foreground="#566070" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="#F8F8F8"/>
                </Style>
            </TabControl.Resources>

            <!-- ── 个人身份 ── -->
            <TabItem Header="{local:Loc SettingsTabIdentity}">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,20">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsLanguageSection}"/>
                        <ComboBox SelectedIndex="{Binding LanguageIndex, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left" MinWidth="220" Margin="0,2,0,4"
                                  Padding="8,4">
                            <ComboBoxItem Content="{local:Loc SettingsLangSystem}"/>
                            <ComboBoxItem Content="{local:Loc SettingsLangChinese}"/>
                            <ComboBoxItem Content="{local:Loc SettingsLangEnglish}"/>
                        </ComboBox>
                        <TextBlock Text="{local:Loc SettingsLanguageHint}"
                                   FontSize="11" Foreground="#9AA1B5" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsNameDetectConfig}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsNameLabel}"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsNicknamesLabel}"/>
                        <TextBox Text="{Binding UserNicknames, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsAsrVariantsLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding UserAsrVariants, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{local:Loc SettingsAsrVariantsTooltip}"/>
                                </ToolTipService.ToolTip>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Command="{Binding GenerateAsrVariantsCommand}"
                                    Padding="10,0"
                                    MinWidth="72"
                                    VerticalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                        <Setter Property="Content" Value="{local:Loc SettingsGenerateBtn}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeneratingAsrVariants}" Value="True">
                                                <Setter Property="Content" Value="{local:Loc CommonGenerating}"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding AsrVariantsError}"
                                   Foreground="#F87171"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasAsrVariantsError,
                                       Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsRoleLabel}"/>
                        <TextBox Text="{Binding UserRole, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#7B8499" LineHeight="20">
                                <Run Text="{local:Loc SettingsIdentityHint1}"/><LineBreak/>
                                <Run Text="{local:Loc SettingsIdentityHint2}"/><LineBreak/>
                                <Run Text="{local:Loc SettingsIdentityHint3}"/>
                            </TextBlock>
                        </Border>

                        <!-- Data directory -->
                        <Rectangle Height="1" Margin="0,22,0,2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                                    <GradientStop Color="#FFE0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsDataDirHeader}"/>

                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2E3448" LineHeight="20">
                                <Run Text="{local:Loc SettingsDataDirHint1}"/><LineBreak/>
                                <Run Text="{local:Loc SettingsDataDirHint2}"/>
                            </TextBlock>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsCurrentDir}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="12"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1"
                                    Content="{local:Loc SettingsBrowse}"
                                    Style="{StaticResource TestBtn}"
                                    Command="{Binding BrowseDataDirectoryCommand}"
                                    Padding="10,7" Margin="0,0,6,0"/>
                            <Button Grid.Column="2"
                                    Content="{local:Loc SettingsOpen}"
                                    Style="{StaticResource TestBtn}"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Padding="10,7"/>
                        </Grid>

                        <!-- Migrate button -->
                        <Button Content="{local:Loc SettingsMigrate}"
                                Style="{StaticResource TestBtn}"
                                Command="{Binding MigrateDataDirectoryCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,7" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="{local:Loc SettingsMigrateHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 大模型 ── -->
            <TabItem Header="{local:Loc SettingsTabLlm}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: profile list -->
                    <Border Grid.Column="0" Background="#F8F8F8"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="8,8,8,4"
                                     ItemsSource="{Binding LlmProfiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     ItemContainerStyle="{StaticResource ProfileListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LlmProfileItem}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Active indicator -->
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                <TextBlock Text="{local:Loc SettingsInUse}" FontSize="9" Foreground="#16A34A"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ModelId}" FontSize="10"
                                                       Foreground="#3D4455" Margin="12,2,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add / Delete buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        Margin="8,4,8,10" HorizontalAlignment="Left">
                                <Button Content="{local:Loc SettingsAddProfile}"
                                        Style="{StaticResource TestBtn}"
                                        Command="{Binding AddProfileCommand}"
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="{local:Loc CommonDelete}"
                                        Style="{StaticResource TestBtn}"
                                        Command="{Binding DeleteProfileCommand}"
                                        Padding="10,5" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: edit form -->
                    <ScrollViewer Grid.Column="1" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,12,20,20">

                            <!-- Empty state -->
                            <TextBlock Text="{local:Loc SettingsSelectProfileHint}"
                                       Foreground="#2E3448" FontSize="13"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,60,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedProfile}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Edit form (shown when profile selected) -->
                            <StackPanel Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVis}}">

                                <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsApiConfig}"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsProfileName}"/>
                                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsBaseUrl}"/>
                                <TextBox Text="{Binding SelectedProfile.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{local:Loc SettingsBaseUrlHint}"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key"/>
                                <PasswordBox x:Name="ProfileApiKeyBox"
                                             FontFamily="Consolas"
                                             PasswordChanged="ProfileApiKeyBox_PasswordChanged"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{local:Loc SettingsApiKeyHint}"/>

                                <Grid Margin="0,12,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{local:Loc SettingsModelId}"
                                               Foreground="#4A5568" FontSize="11" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TestBtn}"
                                            Command="{Binding FetchModelsCommand}"
                                            Padding="10,3" FontSize="11">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{local:Loc SettingsFetchModels}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFetchingModels}" Value="True">
                                                                <Setter Property="Text" Value="{local:Loc SettingsFetchingModels}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                                <ComboBox IsEditable="True"
                                          Text="{Binding SelectedProfile.ModelId, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding AvailableModels}"
                                          Background="#F8F8F8" Foreground="#111111"
                                          BorderBrush="#DDDDDD" BorderThickness="1"/>
                                <TextBlock Text="{Binding ModelsFetchError}"
                                           Foreground="#F87171" FontSize="11"
                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasModelsFetchError,
                                               Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{local:Loc SettingsModelIdHint}"/>

                                <!-- Vision model config -->
                                <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsVisionModelLabel}"/>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding SelectedProfile.VisionModelId, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding AvailableModels}"
                                                  Background="#F8F8F8" Foreground="#111111"
                                                  BorderBrush="#DDDDDD" BorderThickness="1"/>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{local:Loc SettingsVisionModelHint}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsCompressionModelLabel}"/>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding SelectedProfile.CompressionModelId, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding AvailableModels}"
                                                  Background="#F8F8F8" Foreground="#111111"
                                                  BorderBrush="#DDDDDD" BorderThickness="1"/>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{local:Loc SettingsCompressionModelHint}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Active status + set active button -->
                                <Border Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#777777"/>
                                                        <Setter Property="Text" Value="{local:Loc SettingsInactive}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedProfile.IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                                <Setter Property="Text" Value="{local:Loc SettingsActiveNow}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{local:Loc SettingsAutoTestHint}"
                                                       Foreground="#2E3448" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{local:Loc SettingsSetActive}"
                                                Style="{StaticResource TestBtn}"
                                                Command="{Binding SetActiveProfileCommand}"
                                                Padding="12,7" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── 多模态提供商（跨供应商分流） ── -->
            <TabItem Header="{local:Loc SettingsTabMultimodal}">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,12,28,20">
                        <Border Background="#FAFAFA" CornerRadius="10"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#7C3AED"
                                           Text="{local:Loc SettingsVisionProviderHeader}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{local:Loc SettingsVisionProviderDesc}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsVisionBaseUrl}" Margin="0,12,0,0"/>
                                <TextBox Text="{Binding VisionProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key"/>
                                <PasswordBox x:Name="VisionApiKeyBox"
                                             FontFamily="Consolas"
                                             PasswordChanged="VisionApiKeyBox_PasswordChanged"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsVisionModelId}"/>
                                <TextBox Text="{Binding VisionProviderModelId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 语音识别 ── -->
            <TabItem Header="{local:Loc SettingsTabAsr}">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,12,28,20">

                        <!-- ── ASR 引擎 ── -->
                        <Border Background="#FAFAFA" CornerRadius="10"
                                BorderBrush="#EEEEEE" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{local:Loc SettingsLocalAsr}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#3D4455"/>
                                    <TextBlock Text="{local:Loc SettingsLocalAsrDesc}"
                                               FontSize="11" Foreground="#2E3448"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── 麦克风采集 ── -->
                        <Rectangle Height="1" Margin="0,22,0,16">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                                    <GradientStop Color="#FFE0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsMicHeader}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InfoBox}" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#566070" LineHeight="18">
                                <Run Text="{local:Loc SettingsMicHint}"/>
                            </TextBlock>
                        </Border>

                        <!-- Mic toggle -->
                        <Border Background="#FAFAFA" CornerRadius="8"
                                BorderBrush="#EEEEEE" BorderThickness="1" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc SettingsMicEnable}" FontSize="13" Foreground="#3D4455"/>
                                    <TextBlock FontSize="11" Foreground="#2E3448" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{local:Loc SettingsMicOff}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MicEnabled}" Value="True">
                                                        <Setter Property="Text" Value="{local:Loc SettingsMicOn}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding MicEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                    Background="#DDDDDD" Cursor="Hand">
                                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                                        Background="White" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Margin="3,0,0,0">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="ThumbOffset" X="0"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbOffset"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 To="20" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbOffset"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="Track" Property="Background" Value="#6366F1"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Track" Property="BorderBrush" Value="#6366F1"/>
                                                    <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- Mic device selector -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding MicEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc SettingsMicDevice}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          IsEditable="True"
                                          Text="{Binding MicDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding MicDeviceNames}"
                                          Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Content="{local:Loc CommonRefreshPlain}"
                                        Style="{StaticResource TestBtn}"
                                        Command="{Binding RefreshMicDevicesCommand}"
                                        Padding="12,7"/>
                            </Grid>
                        </StackPanel>

                        <!-- ── 会议自动检测 (W5) ── -->
                        <Rectangle Height="1" Margin="0,22,0,16" Fill="#E0E0E0"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsAutoDetectHeader}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InfoBox}" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#566070" LineHeight="18"
                                       Text="{local:Loc SettingsAutoDetectDesc}"/>
                        </Border>
                        <Border Background="#FAFAFA" CornerRadius="8"
                                BorderBrush="#EEEEEE" BorderThickness="1" Padding="10,8" Margin="0,0,0,16">
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding MeetingAutoDetectMode, Mode=TwoWay}">
                                <ComboBoxItem Tag="off">
                                    <TextBlock Text="{local:Loc AutoDetectOff}"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="prompt">
                                    <TextBlock Text="{local:Loc AutoDetectPrompt}"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="auto">
                                    <TextBlock Text="{local:Loc AutoDetectAuto}"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Border>

                        <!-- ── 声纹库 (W2) ── -->
                        <Rectangle Height="1" Margin="0,6,0,16" Fill="#E0E0E0"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsVoiceprintHeader}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InfoBox}" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#566070" LineHeight="18"
                                       Text="{local:Loc SettingsVoiceprintDesc}"/>
                        </Border>
                        <Border Background="#FAFAFA" CornerRadius="8"
                                BorderBrush="#EEEEEE" BorderThickness="1" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{local:Loc VoiceprintEmpty}" FontSize="12" Foreground="#8A93A6"
                                           Margin="4,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Voiceprints.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Voiceprints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#3D4455"/>
                                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#8A93A6"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{local:Loc VoiceprintRename}"
                                                        Style="{StaticResource TestBtn}" Padding="10,5" Margin="4,0"
                                                        Command="{Binding DataContext.RenameVoiceprintCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="3" Content="{local:Loc CommonDelete}"
                                                        Style="{StaticResource TestBtn}" Padding="10,5" Margin="4,0"
                                                        Command="{Binding DataContext.DeleteVoiceprintCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,2" HorizontalAlignment="Right">
                                    <Button Content="{local:Loc VoiceprintMergeSelected}"
                                            Style="{StaticResource TestBtn}" Padding="12,6" Margin="4,0"
                                            Command="{Binding MergeSelectedVoiceprintsCommand}"/>
                                    <Button Content="{local:Loc VoiceprintClearAll}"
                                            Style="{StaticResource TestBtn}" Padding="12,6" Margin="4,0"
                                            Command="{Binding ClearAllVoiceprintsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 使用统计 ── -->
            <TabItem Header="{local:Loc SettingsTabStats}">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,20">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc SettingsStatsHeader}"/>
                        <TextBlock Text="{local:Loc CommonLoading}" Foreground="#888888" FontSize="11"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding StatsLoading, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2E3448">
                                <Run Text="{local:Loc SettingsStatsHint}"/>
                            </TextBlock>
                        </Border>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,8"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc SettingsStatSessions}" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsSessions}" Foreground="#818CF8"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,8"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc SettingsStatTotalTime}" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsTotalTime}" Foreground="#22C55E"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc SettingsStatTranscripts}" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsTranscripts}" Foreground="#60A5FA"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc SettingsStatScreenshots}" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsScreenshots}" Foreground="#34D399"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Data clearing -->
                        <Rectangle Height="1" Margin="0,20,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                                    <GradientStop Color="#FFE0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="{local:Loc SettingsClearData}" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{local:Loc SettingsClearTranscripts}"
                                    Command="{Binding ClearTranscriptHistoryCommand}"
                                    Margin="0,0,6,0"
                                    Padding="0,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                        <Setter Property="BorderBrush" Value="#4D1F1F"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1"
                                    Content="{local:Loc SettingsClearScreenshots}"
                                    Command="{Binding ClearScreenshotHistoryCommand}"
                                    Margin="6,0,0,0"
                                    Padding="0,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                        <Setter Property="BorderBrush" Value="#4D1F1F"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <TextBlock Foreground="#3D4455" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="{local:Loc SettingsClearScreenshotsHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#F8F8F8" Padding="24,14">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.3"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.7"/>
                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,1,0,0</Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status + config actions -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                    <!-- Config clear -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{local:Loc SettingsClearConfig}"
                                Command="{Binding ClearAllConfigCommand}"
                                Padding="14,8" Margin="0,2,0,2"
                                ToolTip="{local:Loc SettingsClearConfigTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#F87171"/>
                                            <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Status text from data-dir / import / export operations -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding DataDirStatus}"
                                   Foreground="#566070" FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   ToolTip="{Binding DataDirStatus}"/>
                        <TextBlock Text="{Binding SaveStatus}"
                                   FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   ToolTip="{Binding SaveStatus}"
                                   Visibility="{Binding HasSaveStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#F87171"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Test results -->
                    <TextBlock FontSize="11"
                               Visibility="{Binding HasAsrTestResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AsrTestSucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="ASR  "/><Run Text="{Binding AsrTestResult}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding HasConnectionTestResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LlmTestSucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="LLM  "/><Run Text="{Binding ConnectionTestResult}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right: test + save buttons -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <Button Content="{local:Loc SettingsCollectLogs}"
                            Style="{StaticResource TestBtn}"
                            Padding="14,8" Margin="0,2,8,2"
                            Click="CollectLogsButton_Click"/>
                    <Button Content="{local:Loc SettingsExportConfig}"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding ExportConfigCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="{local:Loc SettingsImportConfig}"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding ImportConfigCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="{local:Loc SettingsTestAsr}"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding TestAsrConnectionCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="{local:Loc SettingsTestLlm}"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding TestConnectionCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="{local:Loc SettingsSave}"
                            Style="{StaticResource PrimaryBtn}"
                            Command="{Binding SaveSettingsCommand}"
                            IsDefault="True"
                            Padding="22,8" Margin="0,2,0,2"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
