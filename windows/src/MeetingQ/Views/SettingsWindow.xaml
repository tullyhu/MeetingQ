<Window x:Class="MeetingQ.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:MeetingQ.ViewModels"
        mc:Ignorable="d"
        Title="MeetingQ 设置"
        Width="660" Height="620"
        MinWidth="520" MinHeight="480"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        Foreground="#111111"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Cursor="Hand"
                                BorderThickness="0,0,0,2">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="TabUnderline" Color="Transparent"/>
                            </Border.BorderBrush>
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#818CF8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="InfoBox" TargetType="Border">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TestBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#818CF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile list item -->
        <Style x:Key="ProfileListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F8F8F8" Padding="24,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.2"/>
                    <GradientStop Color="#FF6366F1" Offset="0.5"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.8"/>
                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="MeetingQ" Foreground="#818CF8" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="  /" Foreground="#DDDDDD" FontSize="14"/>
                <TextBlock Text="  设置" Foreground="#566070" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="#F8F8F8"/>
                </Style>
            </TabControl.Resources>

            <!-- ── 个人身份 ── -->
            <TabItem Header="个人身份">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,20">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="名字检测配置"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="姓名"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="昵称（逗号分隔）"/>
                        <TextBox Text="{Binding UserNicknames, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ASR同音变体（逗号分隔）"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding UserAsrVariants, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,0">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="填写 ASR 可能将你的名字误识别成的同音词，多个用逗号分隔"/>
                                </ToolTipService.ToolTip>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Command="{Binding GenerateAsrVariantsCommand}"
                                    Padding="10,0"
                                    MinWidth="72"
                                    VerticalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                        <Setter Property="Content" Value="🤖 生成"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeneratingAsrVariants}" Value="True">
                                                <Setter Property="Content" Value="生成中…"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding AsrVariantsError}"
                                   Foreground="#F87171"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasAsrVariantsError,
                                       Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="角色标签（可选）"/>
                        <TextBox Text="{Binding UserRole, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#7B8499" LineHeight="20">
                                软件在转录文本中匹配你的姓名 / 昵称。<LineBreak/>
                                若 ASR 将名字误识别成同音词，填入同音变体即可触发提醒。<LineBreak/>
                                点击"🤖 生成"让 AI 自动推断可能的同音误识词。
                            </TextBlock>
                        </Border>

                        <!-- Data directory -->
                        <Rectangle Height="1" Margin="0,22,0,2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                                    <GradientStop Color="#FFE0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="数据存储目录"/>

                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2E3448" LineHeight="20">
                                配置文件和加密数据存储在此目录。可迁移到其他磁盘，<LineBreak/>
                                但 DPAPI 加密与 Windows 账户绑定，无法跨机器解密。
                            </TextBlock>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="当前目录"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="12"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1"
                                    Content="浏览..."
                                    Style="{StaticResource TestBtn}"
                                    Command="{Binding BrowseDataDirectoryCommand}"
                                    Padding="10,7" Margin="0,0,6,0"/>
                            <Button Grid.Column="2"
                                    Content="打开"
                                    Style="{StaticResource TestBtn}"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Padding="10,7"/>
                        </Grid>

                        <!-- Migrate button -->
                        <Button Content="迁移现有数据到新目录"
                                Style="{StaticResource TestBtn}"
                                Command="{Binding MigrateDataDirectoryCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,7" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="更改后点「保存设置」生效；建议先「迁移」再保存，否则旧数据仍在原目录"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 大模型 ── -->
            <TabItem Header="大模型">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: profile list -->
                    <Border Grid.Column="0" Background="#F8F8F8"
                            BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="8,8,8,4"
                                     ItemsSource="{Binding LlmProfiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     ItemContainerStyle="{StaticResource ProfileListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LlmProfileItem}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Active indicator -->
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                <TextBlock Text="使用中" FontSize="9" Foreground="#16A34A"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ModelId}" FontSize="10"
                                                       Foreground="#3D4455" Margin="12,2,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add / Delete buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        Margin="8,4,8,10" HorizontalAlignment="Left">
                                <Button Content="+ 添加"
                                        Style="{StaticResource TestBtn}"
                                        Command="{Binding AddProfileCommand}"
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="删除"
                                        Style="{StaticResource TestBtn}"
                                        Command="{Binding DeleteProfileCommand}"
                                        Padding="10,5" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: edit form -->
                    <ScrollViewer Grid.Column="1" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,12,20,20">

                            <!-- Empty state -->
                            <TextBlock Text="← 选择或添加一个大模型配置"
                                       Foreground="#2E3448" FontSize="13"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,60,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedProfile}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Edit form (shown when profile selected) -->
                            <StackPanel Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVis}}">

                                <TextBlock Style="{StaticResource SectionHeader}" Text="接口配置"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="配置名称"/>
                                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="接口地址（Base URL）"/>
                                <TextBox Text="{Binding SelectedProfile.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="示例：https://ark.cn-beijing.volces.com/api/v3  /  https://dashscope.aliyuncs.com/compatible-mode/v1"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key"/>
                                <PasswordBox x:Name="ProfileApiKeyBox"
                                             FontFamily="Consolas"
                                             PasswordChanged="ProfileApiKeyBox_PasswordChanged"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="API Key 保存时经 Windows DPAPI 加密，不会明文存储"/>

                                <Grid Margin="0,12,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="模型 ID / Endpoint ID"
                                               Foreground="#4A5568" FontSize="11" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TestBtn}"
                                            Command="{Binding FetchModelsCommand}"
                                            Padding="10,3" FontSize="11">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="获取列表"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFetchingModels}" Value="True">
                                                                <Setter Property="Text" Value="获取中…"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                                <ComboBox IsEditable="True"
                                          Text="{Binding SelectedProfile.ModelId, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding AvailableModels}"
                                          Background="#F8F8F8" Foreground="#111111"
                                          BorderBrush="#DDDDDD" BorderThickness="1"/>
                                <TextBlock Text="{Binding ModelsFetchError}"
                                           Foreground="#F87171" FontSize="11"
                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasModelsFetchError,
                                               Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="示例：gpt-4o-mini  /  qwen-turbo  /  doubao-1-5-pro-32k  /  ep-xxxxxxxx-xxxxx"/>

                                <!-- Vision model config -->
                                <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vision 模型 ID（可选，多模态截图分析用）"/>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding SelectedProfile.VisionModelId, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding AvailableModels}"
                                                  Background="#F8F8F8" Foreground="#111111"
                                                  BorderBrush="#DDDDDD" BorderThickness="1"/>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="留空则复用 Model ID。多模态请求自动走此模型，纯文本请求仍走 Model ID"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="压缩模型 ID（可选，长会议上下文压缩用）"/>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding SelectedProfile.CompressionModelId, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding AvailableModels}"
                                                  Background="#F8F8F8" Foreground="#111111"
                                                  BorderBrush="#DDDDDD" BorderThickness="1"/>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="留空则复用 Model ID。用于压缩长会议历史，可用速度较快的轻量模型"/>
                                    </StackPanel>
                                </Border>

                                <!-- Active status + set active button -->
                                <Border Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#777777"/>
                                                        <Setter Property="Text" Value="未激活"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedProfile.IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                                <Setter Property="Text" Value="当前使用中"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="启动监听时将自动测试此接口"
                                                       Foreground="#2E3448" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="设为当前使用"
                                                Style="{StaticResource TestBtn}"
                                                Command="{Binding SetActiveProfileCommand}"
                                                Padding="12,7" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── 多模态提供商（跨供应商分流） ── -->
            <TabItem Header="多模态">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,12,28,20">
                        <Border Background="#FAFAFA" CornerRadius="10"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#7C3AED"
                                           Text="🖼 多模态 Vision 提供商（可选）"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="填写此项后，截图分析请求将使用此供应商，纯文本请求仍使用「大模型」Tab 中激活的配置。留空则使用激活配置中设置的 Vision 模型 ID。"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL（多模态 API 端点）" Margin="0,12,0,0"/>
                                <TextBox Text="{Binding VisionProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key"/>
                                <PasswordBox x:Name="VisionApiKeyBox"
                                             FontFamily="Consolas"
                                             PasswordChanged="VisionApiKeyBox_PasswordChanged"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Vision 模型 ID"/>
                                <TextBox Text="{Binding VisionProviderModelId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 语音识别 ── -->
            <TabItem Header="语音识别">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,12,28,20">

                        <!-- ── ASR 引擎 ── -->
                        <Border Background="#FAFAFA" CornerRadius="10"
                                BorderBrush="#EEEEEE" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="本地离线语音识别" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#3D4455"/>
                                    <TextBlock Text="sherpa-onnx 流式 Paraformer · 说话人识别 · 语音不出本机"
                                               FontSize="11" Foreground="#2E3448"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── 麦克风采集 ── -->
                        <Rectangle Height="1" Margin="0,22,0,16">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                                    <GradientStop Color="#FFE0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="麦克风采集（混音）" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InfoBox}" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#566070" LineHeight="18">
                                开启后麦克风输入与系统音频混合送入 ASR，适合本地说话也需被识别的场景。
                            </TextBlock>
                        </Border>

                        <!-- Mic toggle -->
                        <Border Background="#FAFAFA" CornerRadius="8"
                                BorderBrush="#EEEEEE" BorderThickness="1" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🎤 启用麦克风采集" FontSize="13" Foreground="#3D4455"/>
                                    <TextBlock FontSize="11" Foreground="#2E3448" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="当前已关闭"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MicEnabled}" Value="True">
                                                        <Setter Property="Text" Value="当前已开启"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding MicEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                    Background="#DDDDDD" Cursor="Hand">
                                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                                        Background="White" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Margin="3,0,0,0">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="ThumbOffset" X="0"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbOffset"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 To="20" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbOffset"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="Track" Property="Background" Value="#6366F1"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Track" Property="BorderBrush" Value="#6366F1"/>
                                                    <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- Mic device selector -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding MicEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="麦克风设备" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          IsEditable="True"
                                          Text="{Binding MicDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding MicDeviceNames}"
                                          Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Content="刷新"
                                        Style="{StaticResource TestBtn}"
                                        Command="{Binding RefreshMicDevicesCommand}"
                                        Padding="12,7"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 使用统计 ── -->
            <TabItem Header="使用统计">
                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,20">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="本机使用统计"/>
                        <TextBlock Text="加载中…" Foreground="#888888" FontSize="11"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding StatsLoading, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2E3448">
                                以下数据来自本地 SQLite 数据库，不上传至任何服务器。
                            </TextBlock>
                        </Border>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,8"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="会议次数" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsSessions}" Foreground="#818CF8"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,8"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="累计时长" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsTotalTime}" Foreground="#22C55E"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="转录条数" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsTranscripts}" Foreground="#60A5FA"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"
                                    Background="#F8F8F8" CornerRadius="8"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="截图张数" Foreground="#3D4455" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatsScreenshots}" Foreground="#34D399"
                                               FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Data clearing -->
                        <Rectangle Height="1" Margin="0,20,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                                    <GradientStop Color="#FFE0E0E0" Offset="0.5"/>
                                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="清空数据" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="🗑 清空转录历史"
                                    Command="{Binding ClearTranscriptHistoryCommand}"
                                    Margin="0,0,6,0"
                                    Padding="0,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                        <Setter Property="BorderBrush" Value="#4D1F1F"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1"
                                    Content="🗑 清空截图历史"
                                    Command="{Binding ClearScreenshotHistoryCommand}"
                                    Margin="6,0,0,0"
                                    Padding="0,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                        <Setter Property="BorderBrush" Value="#4D1F1F"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <TextBlock Foreground="#3D4455" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="清空截图历史将同时删除磁盘上的图片文件，此操作不可撤销。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#F8F8F8" Padding="24,14">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E0E0E0" Offset="0"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.3"/>
                    <GradientStop Color="#FFE0E0E0" Offset="0.7"/>
                    <GradientStop Color="#00E0E0E0" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,1,0,0</Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status + config actions -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                    <!-- Config clear -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="清空配置"
                                Command="{Binding ClearAllConfigCommand}"
                                Padding="14,8" Margin="0,2,0,2"
                                ToolTip="删除所有配置（不影响会议记录数据库）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TestBtn}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#F87171"/>
                                            <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Status text from data-dir / import / export operations -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding DataDirStatus}"
                                   Foreground="#566070" FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   ToolTip="{Binding DataDirStatus}"/>
                        <TextBlock Text="{Binding SaveStatus}"
                                   FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   ToolTip="{Binding SaveStatus}"
                                   Visibility="{Binding HasSaveStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#F87171"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Test results -->
                    <TextBlock FontSize="11"
                               Visibility="{Binding HasAsrTestResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AsrTestResult}" Value="AST ASR 连接成功 ✓">
                                        <Setter Property="Foreground" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="ASR  "/><Run Text="{Binding AsrTestResult}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding HasConnectionTestResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionTestResult}" Value="LLM 连接成功 ✓">
                                        <Setter Property="Foreground" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="LLM  "/><Run Text="{Binding ConnectionTestResult}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right: test + save buttons -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <Button Content="📋 收集日志"
                            Style="{StaticResource TestBtn}"
                            Padding="14,8" Margin="0,2,8,2"
                            Click="CollectLogsButton_Click"/>
                    <Button Content="导出配置"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding ExportConfigCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="导入配置"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding ImportConfigCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="测试 ASR"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding TestAsrConnectionCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="测试 LLM"
                            Style="{StaticResource TestBtn}"
                            Command="{Binding TestConnectionCommand}"
                            Padding="14,8" Margin="0,2,8,2"/>
                    <Button Content="保存设置"
                            Style="{StaticResource PrimaryBtn}"
                            Command="{Binding SaveSettingsCommand}"
                            IsDefault="True"
                            Padding="22,8" Margin="0,2,0,2"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
