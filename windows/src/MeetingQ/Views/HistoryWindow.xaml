<Window x:Class="MeetingQ.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:MeetingQ.ViewModels"
        xmlns:conv="clr-namespace:MeetingQ.Views"
        xmlns:local="clr-namespace:MeetingQ.Infrastructure"
        mc:Ignorable="d"
        Title="{local:Loc HistoryTitle}"
        Width="780" Height="540"
        MinWidth="560" MinHeight="380"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF"
        Foreground="#111111"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:FilePathToImageConverter x:Key="PathToImage"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#888888"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#EEEEEE"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="160" MaxWidth="420"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left: session list ══ -->
        <Grid Grid.Column="0" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="14,0,8,0" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗂"  FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Loc HistoryTitle}"
                                   Foreground="#6366F1" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="{local:Loc CommonRefresh}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding RefreshCommand}"
                            Padding="8,2" FontSize="10"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Search -->
            <Border Grid.Row="1" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FFFFFF" BorderBrush="#DDDDDD"
                         FontSize="11" Padding="6,3"
                         ToolTip="{local:Loc HistorySearchHint}"/>
            </Border>

            <!-- List -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding SelectedSession}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#111111" FontSize="12" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TopicsLabel}"
                                       Foreground="#888888" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       MaxHeight="28"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding TranscriptCountLabel}"
                                           Foreground="#AAAAAA" FontSize="10"/>
                                <TextBlock Text="  ·  " Foreground="#DDDDDD" FontSize="10"
                                           Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="📷" FontSize="9"
                                           Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVis}}"
                                           ToolTip="{local:Loc HistoryHasScreenshots}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DateLabel}"
                                       Foreground="#AAAAAA" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status / refresh -->
            <Border Grid.Row="3" Padding="14,0" BorderThickness="0,1,0,0" BorderBrush="#EEEEEE">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#AAAAAA" FontSize="10"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Divider (draggable) -->
        <GridSplitter Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch"
                      Background="#EEEEEE"
                      Cursor="SizeWE"/>

        <!-- ══ Right: session detail ══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="{local:Loc HistorySelectPrompt}"
                           Foreground="#AAAAAA" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Loading detail indicator -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,8,12,0" Padding="8,4" CornerRadius="4"
                    Background="#EEF2FF"
                    Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{local:Loc CommonLoading}" Foreground="#6366F1" FontSize="11"/>
            </Border>

            <!-- Detail -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="24,20,24,20"
                          Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedSession}">

                    <!-- Header -->
                    <TextBlock Text="{Binding Title}"
                               Foreground="#111111" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="#888888" FontSize="11" Margin="0,0,0,18">
                        <Run Text="{Binding DateLabel}"/>
                        <Run Text="  ·  " Foreground="#DDDDDD"/>
                        <Run Text="{Binding DurationLabel}"/>
                        <Run Text="  ·  " Foreground="#DDDDDD"/>
                        <Run Text="{Binding TranscriptCountLabel}"/>
                    </TextBlock>

                    <!-- Topics -->
                    <TextBlock Text="{local:Loc Topics}" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding TopicsLabel}"
                               Foreground="#555555" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Screenshots -->
                    <StackPanel Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{local:Loc Screenshots}" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding ScreenshotPaths}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScreenshotItem}">
                                    <StackPanel Margin="0,0,8,8">
                                        <Border Cursor="Hand"
                                                ToolTip="{local:Loc HistoryClickEnlarge}"
                                                MouseLeftButtonUp="Screenshot_Click">
                                            <Image Source="{Binding Converter={StaticResource PathToImage}}"
                                                   Width="160" Height="90"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding TimeLabel}"
                                                   Foreground="#AAAAAA" FontSize="9"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Decisions -->
                    <StackPanel Visibility="{Binding HasDecisions, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="{local:Loc Decisions}" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding Decisions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="• " Foreground="#16A34A" FontSize="12"/>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#333333" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Action Items -->
                    <StackPanel Visibility="{Binding HasActionItems, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="{local:Loc ActionItems}" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding ActionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActionItemDisplay}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="→ " Foreground="#D97706" FontSize="12"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#333333" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Transcripts -->
                    <StackPanel Visibility="{Binding HasTranscripts, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{local:Loc Transcripts}" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding Transcripts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TranscriptItem}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimeLabel}"
                                                   Foreground="#AAAAAA" FontSize="10"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <TextBlock Text="{Binding Speaker}"
                                                       Foreground="#6366F1" FontSize="10"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="#333333" FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Empty transcripts notice -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTranscripts}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{local:Loc HistoryNoTranscripts}"
                                   Foreground="#AAAAAA" FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ── 问答 rail (W4)：rest / thread 两态，禁用时分原因 ── -->
            <Border Grid.Row="1"
                    Background="#FAFBFF"
                    BorderBrush="#EEEEEE" BorderThickness="0,1,0,0"
                    Padding="16,8"
                    Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ScrollViewer MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasChatThread, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ChatTurns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Question}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#3D4455" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Answer}" FontSize="12"
                                                   Foreground="#566070" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空闲时的一条建议 chip -->
                    <Button Content="{Binding ChatSuggestion}"
                            Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,4"
                            Command="{Binding AskSuggestionCommand}"
                            Visibility="{Binding ShowChatSuggestion, Converter={StaticResource BoolToVis}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ChatDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7" FontSize="12"
                                 Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                            <TextBox.IsEnabled>
                                <Binding Path="ChatEnabled"/>
                            </TextBox.IsEnabled>
                        </TextBox>
                        <Button Grid.Column="1" Content="↑" Margin="8,0,0,0" Padding="12,6"
                                Style="{StaticResource GhostBtn}"
                                Command="{Binding AskAboutMeetingCommand}"
                                IsEnabled="{Binding ChatEnabled}"/>
                    </Grid>
                    <TextBlock Text="{Binding ChatDisabledReason}" FontSize="11" Foreground="#8A93A6"
                               Margin="2,4,0,0"
                               Visibility="{Binding ChatDisabled, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Bottom bar -->
            <Border Grid.Row="2"
                    Background="#F5F5F5"
                    BorderBrush="#EEEEEE" BorderThickness="0,1,0,0"
                    Padding="16,10"
                    Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                <WrapPanel>
                    <Button Content="{local:Loc HistoryExportMd}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2,6,2"
                            Background="#EEF2FF"
                            Foreground="#6366F1"
                            BorderBrush="#C7D2FE"/>
                    <Button Content="{local:Loc HistoryExportHtml}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding DataContext.ExportHtmlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2,6,2"
                            Background="#FFF7ED"
                            Foreground="#EA580C"
                            BorderBrush="#FED7AA"/>
                    <Button Content="{local:Loc HistoryExportTranscript}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding DataContext.ExportTranscriptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2,6,2"
                            Background="#F0FDF4"
                            Foreground="#16A34A"
                            BorderBrush="#BBF7D0"/>
                    <Button Content="{local:Loc HistorySpeakerRename}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding DataContext.EditSpeakersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2,6,2"
                            Background="#EFF6FF"
                            Foreground="#2563EB"
                            BorderBrush="#BFDBFE"/>
                    <Button Content="{local:Loc HistoryVisionAnalysis}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding DataContext.RegenerateWithVisionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2,6,2"
                            Background="#F3E8FF"
                            Foreground="#9333EA"
                            BorderBrush="#D8B4FE"/>
                    <Button Content="{local:Loc HistoryDeleteRecord}"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2,0,2"
                            Background="#FFF5F5"
                            Foreground="#EF4444"
                            BorderBrush="#FECACA"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
