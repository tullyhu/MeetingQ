<Window x:Class="MeetingQ.Views.NameAlertPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="名字提醒"
        Width="420"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border CornerRadius="10"
            Background="#F8F8F8"
            BorderBrush="#60FFB347"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <StackPanel>

            <!-- ══ Header ══ -->
            <Border CornerRadius="10,10,0,0"
                    Background="#FFF3CD"
                    Padding="14,10">
                <Grid>
                    <!-- Elapsed label -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ElapsedText"
                                   Text="有人叫你！"
                                   Foreground="#B45309"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Pin + Close buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="PinButton"
                                Content="📌"
                                FontSize="13"
                                Width="28" Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Opacity="0.5"
                                ToolTip="固定此提示"
                                Click="PinButton_Click"/>
                        <Button Content="✕"
                                FontSize="12"
                                Width="28" Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#777777"
                                Cursor="Hand"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Body (scrollable when content exceeds available space) ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                <StackPanel Margin="14,10,14,14">

                <!-- Screenshot thumbnail (hidden when not available) -->
                <StackPanel x:Name="ScreenshotPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="📸  被叫时截图"
                               Foreground="#B45309"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <Border CornerRadius="6" ClipToBounds="True" MaxHeight="160"
                            Cursor="Hand" ToolTip="点击放大查看"
                            MouseLeftButtonUp="ScreenshotThumbnail_Click">
                        <Image x:Name="ScreenshotImage"
                               Stretch="UniformToFill"
                               StretchDirection="DownOnly"/>
                    </Border>
                </StackPanel>

                <!-- Original quote -->
                <TextBlock Text="原话"
                           Foreground="#B45309"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <Border Background="#FFF3CD"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="OriginalTextBlock"
                                   Foreground="#111111"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <!-- Extracted questions -->
                <TextBlock Text="📍 需要你回答的问题"
                           Foreground="#B45309"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <ItemsControl x:Name="QuestionsItemsControl"
                              Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="#111111"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Context (preceding transcripts) — only shown when non-empty -->
                <StackPanel x:Name="ContextPanel" Visibility="Collapsed">
                    <Rectangle Height="1" Margin="0,0,0,10">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00DDDDDD" Offset="0"/>
                                <GradientStop Color="#55DDDDDD" Offset="0.5"/>
                                <GradientStop Color="#00DDDDDD" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <TextBlock Text="📋 前后上下文（最近1分钟）"
                               Foreground="#777777"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <ItemsControl x:Name="ContextItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#666666"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Action button -->
                <Button Content="✅ 我知道了"
                        HorizontalAlignment="Right"
                        Padding="20,7"
                        Margin="0,12,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="#FFB347"
                        Foreground="#111111"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AcknowledgeButton_Click"/>

                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
