<Window x:Class="MeetingQ.Views.PrivacyNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingQ.Infrastructure"
        Title="{local:Loc PrivacyTitle}"
        Width="480" Height="420"
        MinWidth="400" MinHeight="360"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Foreground="#111111"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{local:Loc PrivacyHeader}"
                       Foreground="#6366F1"
                       FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
            <Rectangle Height="1" Fill="#EEEEEE"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333"
                           LineHeight="22" Margin="0,0,0,14">
                    <Run Text="{local:Loc PrivacyIntroA}"/><Bold><Run Text="{local:Loc PrivacyIntroBold}"/></Bold><Run Text="{local:Loc PrivacyIntroB}"/>
                </TextBlock>

                <TextBlock Text="{local:Loc PrivacyNetworkHeader}" Foreground="#2563EB" FontSize="12"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555555"
                           LineHeight="20" Margin="0,0,0,14">
                    <Run Text="{local:Loc PrivacyNetworkBodyA}"/><Bold><Run Text="{local:Loc PrivacyNetworkBold1}"/></Bold><Run Text="{local:Loc PrivacyNetworkBodyB}"/><Bold><Run Text="{local:Loc PrivacyNetworkBold2}"/></Bold><Run Text="{local:Loc PrivacyNetworkBodyC}"/>
                </TextBlock>

                <TextBlock Text="{local:Loc PrivacyStorageHeader}" Foreground="#2563EB" FontSize="12"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555555"
                           LineHeight="20" Margin="0,0,0,14">
                    <Run Text="{local:Loc PrivacyStorageBody}"/>
                </TextBlock>

                <TextBlock Text="{local:Loc PrivacyScopeHeader}" Foreground="#2563EB" FontSize="12"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555555"
                           LineHeight="20">
                    <Run Text="{local:Loc PrivacyScopeBody}"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Rectangle Height="1" Fill="#EEEEEE" Margin="0,0,0,16"/>
            <Button Content="{local:Loc PrivacyAccept}"
                    IsDefault="True"
                    HorizontalAlignment="Right"
                    Padding="24,9"
                    FontSize="13" FontWeight="SemiBold"
                    Background="#6366F1"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="AcceptButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
